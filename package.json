{
  "name": "party-check-in",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "npm run dev --workspace @party-check-in/web",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "npm run build --workspace @party-check-in/web",
    "build:worker": "npm run build --workspace @party-check-in/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply party-check-in --local",
    "db:migrate:remote": "wrangler d1 migrations apply party-check-in --remote",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "wrangler": "4.120.0"
  }
}
